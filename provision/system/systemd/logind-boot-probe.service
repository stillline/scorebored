[Unit]
Description=Diagnostic: probe systemd-logind responsiveness during boot
After=systemd-logind.service dbus.service
Wants=systemd-logind.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/logind-boot-probe.sh
StandardOutput=journal
SyslogIdentifier=logind-boot-probe

[Install]
WantedBy=multi-user.target
