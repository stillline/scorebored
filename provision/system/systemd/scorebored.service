[Unit]
Description=Scorebored - Live Scoreboard Server
# Start as soon as NetworkManager is up, not after every uplink is online:
# network-online.target waits for all auto-connect profiles (a slow venue or
# home Wi-Fi association held the server back 35 s on 2026-10-12). The server
# binds all interfaces, and the ATEM link and sync providers retry on their own.
After=NetworkManager.service network.target
Wants=NetworkManager.service

[Service]
Type=simple
User=matthew
Group=matthew
Environment=HOME=/home/matthew
Environment=XDG_RUNTIME_DIR=/run/user/1000
WorkingDirectory=/home/matthew/bin/scorebored
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scorebored

[Install]
WantedBy=multi-user.target
