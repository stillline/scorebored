[Unit]
Description=MediaMTX (ATEM RTMP ingest -> SRT court relay push)
Documentation=https://github.com/bluenviron/mediamtx
After=network.target

[Service]
User=mediamtx
Group=mediamtx
ExecStart=/usr/local/bin/mediamtx /etc/mediamtx/mediamtx.yml
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/srt-relay

[Install]
WantedBy=multi-user.target
